# Runtime (never commit real values)
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ARCJET_KEY=replace-with-arcjet-key

# Tests must use an isolated disposable database, never production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/CLASSROOM_TEST?sslmode=require
